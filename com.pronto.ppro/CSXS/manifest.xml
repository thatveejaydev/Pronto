<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.pronto.ppro" ExtensionBundleVersion="1.0.0" ExtensionBundleName="PRONTO">
  <ExtensionList>
    <Extension Id="com.pronto.ppro.launcher" Version="1.0.0" />
    <Extension Id="com.pronto.ppro.palette" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.pronto.ppro.launcher">
      <DispatchInfo>
        <Resources>
          <MainPath>./launcher.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PRONTO Launcher</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>360</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.pronto.ppro.palette">
      <DispatchInfo>
        <Resources>
          <MainPath>./palette.html</MainPath>
          <ScriptPath>./host/engine.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Menu>PRONTO</Menu>
          <Geometry>
            <Size>
              <Width>460</Width>
              <Height>60</Height>
            </Size>
            <MinSize>
              <Width>340</Width>
              <Height>60</Height>
            </MinSize>
            <MaxSize>
              <Width>1000</Width>
              <Height>800</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
